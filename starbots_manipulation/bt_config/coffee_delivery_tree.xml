<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence name="MainSequence">
      <Sequence name="Coffee Delivery">
        <ValidateDetection name="Validate Detection"
                           _description="Checks if the cup and holder are detected"/>
        <PrePick name="Pre-pick"
                 _description="Moves robot to pre-pick position"/>
        <Pick _description="Picks up the cup"/>
        <Fallback name="PlaceOrRecover">
          <Sequence name="TrytoPlace">
            <PrePlace name="Pre-place"
                      _description="Moves robot to pre-place position"/>
            <Place _description="Approaches and places the cup in the holder"/>
          </Sequence>
          <Inverter>
            <PutBack name="Put Back" _description="Returns the cup to its original position if place fails"/>
          </Inverter>
          <Return _description="Returns robot to quick-pick pose"/>
        </Fallback>
      </Sequence>
      <Return _description="Returns robot to quick-pick pose"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Pick"/>
    <Action ID="Place"/>
    <Action ID="PrePick"/>
    <Action ID="PrePlace"/>
    <Action ID="PutBack">
    </Action>
    <Action ID="Return"/>
    <Action ID="ValidateDetection"/>
  </TreeNodesModel>

</root>