FROM osrf/ros:humble-desktop
SHELL [ "/bin/bash" , "-c" ]

# Install ROS2 - Moveit and Foxglove dependencies
RUN apt update && apt upgrade -y && apt install -y \
 python3-colcon-common-extensions \
 python3-pcl \
 ros-humble-pcl-* \
 ros-humble-moveit \
 ros-humble-moveit-ros-perception \
 ros-humble-moveit-ros-occupancy-map-monitor \
 ros-humble-octomap \
 ros-humble-octomap-msgs \
 ros-humble-ros2-control \
 ros-humble-ros2-controllers \
 ros-humble-joint-state-publisher \
 ros-humble-joint-state-broadcaster \
 ros-humble-xacro \
 ros-humble-gazebo-ros-pkgs \
 ros-humble-foxglove-bridge \
 && rm -rf /var/lib/apt/lists/*

# Create ros2 workspace
RUN mkdir -p /ros2_ws/src
COPY ./ur3e_moveit_config /ros2_ws/src/ur3e_moveit_config
COPY ./starbots_ur3e /ros2_ws/src/starbots_ur3e
COPY ./starbots_perception /ros2_ws/src/starbots_perception
COPY ./starbots_manipulation /ros2_ws/src/starbots_manipulation
COPY ./starbots_webapp /ros2_ws/src/starbots_webapp
COPY ./starbots_bringup /ros2_ws/src/starbots_bringup
COPY ./docker/ros_entrypoint.sh /ros_entrypoint.sh

# Build the ros2 workspace
RUN source /opt/ros/humble/setup.bash \
 && cd /ros2_ws \
 && colcon build

WORKDIR /ros2_ws